### WarriorFit API — HTTP Test Suite
### Base URL and auth are configured in http-client.env.json
### Run each request by clicking the ▶ button next to ###

### ─────────────────────────────────────────────────────
### 1. AUTHENTICATION
### ─────────────────────────────────────────────────────

### 1a. Login (OAuth2) — stores token in warriorfit_token variable
# @name login
POST {{base_url}}/token
Content-Type: application/x-www-form-urlencoded

username={{username}}&password={{password}}

> {%
    client.test("Login returns 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Response has access_token", function() {
        client.assert(response.body.access_token !== undefined, "No access_token in response");
    });
    client.global.set("warriorfit_token", response.body.access_token);
%}

### 1b. Login — wrong credentials (expect 401)
POST {{base_url}}/token
Content-Type: application/x-www-form-urlencoded

username=wrong_user&password=wrong_pass

> {%
    client.test("Wrong credentials returns 401", function() {
        client.assert(response.status === 401, "Expected 401, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────
### 2. GET /crosses — List All Crosses
### ─────────────────────────────────────────────────────

### 2a. API Key auth
GET {{base_url}}/crosses
X-API-Key: {{api_key}}

> {%
    client.test("GET /crosses with API key returns 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Response is an array", function() {
        client.assert(Array.isArray(response.body), "Expected array");
    });
%}

### 2b. Bearer token auth
GET {{base_url}}/crosses
Authorization: Bearer {{warriorfit_token}}

> {%
    client.test("GET /crosses with Bearer token returns 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
%}

### 2c. No auth (expect 403)
GET {{base_url}}/crosses

> {%
    client.test("GET /crosses without auth returns 403", function() {
        client.assert(response.status === 403, "Expected 403, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────
### 3. GET /crosses/{id_cross} — Single Cross
### ─────────────────────────────────────────────────────

### 3a. Get cross by ID (API Key)
GET {{base_url}}/crosses/1
X-API-Key: {{api_key}}

> {%
    client.test("GET /crosses/1 returns 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Response has id field", function() {
        client.assert(response.body.id !== undefined, "No id in response");
    });
%}

### 3b. Get cross — not found (expect 404)
GET {{base_url}}/crosses/99999
X-API-Key: {{api_key}}

> {%
    client.test("GET /crosses/99999 returns 404", function() {
        client.assert(response.status === 404, "Expected 404, got " + response.status);
    });
%}

### 3c. Get cross — invalid ID (expect 422)
GET {{base_url}}/crosses/0
X-API-Key: {{api_key}}

> {%
    client.test("GET /crosses/0 returns 422 (validation error)", function() {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
    });
%}

