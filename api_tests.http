### 4. GET /crosses/runners/{cross_id} — Runners for a Cross
### ─────────────────────────────────────────────────────

### 4a. Get runners for cross 1
GET {{base_url}}/crosses/runners/1
X-API-Key: {{api_key}}

> {%
    client.test("GET /crosses/runners/1 returns 200", function() {
        client.assert(response.status === 200, "Expected 200, got " + response.status);
    });
    client.test("Response is an array", function() {
        client.assert(Array.isArray(response.body), "Expected array");
    });
%}

### ─────────────────────────────────────────────────────
### 5. POST /crosses/{serial_number}/{id_cross} — Add Runner
### ─────────────────────────────────────────────────────

### 5a. Add runner RUNNER001 to cross 1
POST {{base_url}}/crosses/RUNNER001/1
X-API-Key: {{api_key}}

> {%
    client.test("Add runner returns 201", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### 5b. Alternate route — add runner
POST {{base_url}}/crosses/runner/RUNNER002/1
X-API-Key: {{api_key}}

> {%
    client.test("Alternate add runner returns 201", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### 5c. Invalid serial number (too long, expect 422)
POST {{base_url}}/crosses/TOOLONGSERIAL999/1
X-API-Key: {{api_key}}

> {%
    client.test("Invalid serial returns 422", function() {
        client.assert(response.status === 422, "Expected 422, got " + response.status);
    });
%}

### ─────────────────────────────────────────────────────
### 6. POST /crosses/{cross_id} — Save Bulk Recordings
### ─────────────────────────────────────────────────────

### 6a. Save bulk recordings for cross 1
POST {{base_url}}/crosses/1
X-API-Key: {{api_key}}
Content-Type: application/json

[
  { "serial_number": "RUNNER001", "time": 125.5 },
  { "serial_number": "RUNNER002", "time": 132.3 },
  { "serial_number": "RUNNER003", "time": 118.7 }
]

> {%
    client.test("Save bulk recordings returns 201", function() {
        client.assert(response.status === 201, "Expected 201, got " + response.status);
    });
%}

### 6b. Save empty recordings (expect 400)
POST {{base_url}}/crosses/1
X-API-Key: {{api_key}}
Content-Type: application/json

[]

> {%
    client.test("Empty recordings returns 400", function() {
        client.assert(response.status === 400, "Expected 400, got " + response.status);
    });
%}